{
  "name": "git-commit-geniex",
  "displayName": "%displayName%",
  "publisher": "northwang-lucky",
  "description": "%description%",
  "version": "3.2.3",
  "license": "MIT",
  "engines": {
    "vscode": "^1.103.0"
  },
  "icon": "media/Genie.png",
  "categories": [
    "AI",
    "SCM Providers",
    "Linters"
  ],
  "keywords": [
    "git",
    "commit",
    "ai",
    "geniex",
    "llm",
    "automation",
    "gpt",
    "claude",
    "gemini",
    "deepseek",
    "qwen",
    "glm",
    "kimi",
    "openrouter",
    "commit message",
    "git workflow",
    "source control",
    "commit message generater",
    "code review",
    "openai",
    "chatgpt",
    "conventional commits",
    "git commit",
    "scm",
    "source control",
    "productivity",
    "developer tools",
    "ai assistant",
    "commit helper",
    "git helper",
    "commit automation",
    "code quality",
    "semantic commit",
    "code analysis",
    "static analysis",
    "pre-commit",
    "commit hook",
    "version control"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "icons": {
      "genie-base": {
        "description": "Genie base icon",
        "default": {
          "fontPath": "./media/genie.woff",
          "fontCharacter": "\\e000"
        }
      },
      "genie-check": {
        "description": "Genie check icon",
        "default": {
          "fontPath": "./media/genie.woff",
          "fontCharacter": "\\e001"
        }
      },
      "genie-block": {
        "description": "Genie block icon",
        "default": {
          "fontPath": "./media/genie.woff",
          "fontCharacter": "\\e002"
        }
      },
      "genie-warning": {
        "description": "Genie warning icon",
        "default": {
          "fontPath": "./media/genie.woff",
          "fontCharacter": "\\e003"
        }
      },
      "genie-reload": {
        "description": "Genie reload icon",
        "default": {
          "fontPath": "./media/genie.woff",
          "fontCharacter": "\\e004"
        }
      },
      "genie-noRope": {
        "description": "Genie no rope icon",
        "default": {
          "fontPath": "./media/genie.woff",
          "fontCharacter": "\\e005"
        }
      },
      "genie-kill": {
        "description": "Genie kill icon",
        "default": {
          "fontPath": "./media/genie.woff",
          "fontCharacter": "\\e006"
        }
      }
    },
    "configuration": {
      "title": "Git Commit GenieX",
      "properties": {
        "gitCommitGeniex.autoStageAllForDiff": {
          "order": 1,
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.autoStageAllForDiff.desc%",
          "tags": [
            "experimental"
          ]
        },
        "gitCommitGeniex.chain.enabled": {
          "order": 3,
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.chain.enabled.desc%",
          "tags": [
            "experimental"
          ]
        },
        "gitCommitGeniex.chain.maxParallel": {
          "order": 4,
          "type": "number",
          "default": 2,
          "minimum": 1,
          "markdownDescription": "%config.chain.maxParallel.desc%"
        },
        "gitCommitGeniex.llm.maxRetries": {
          "order": 5,
          "type": "number",
          "default": 2,
          "minimum": 1,
          "markdownDescription": "%config.llm.maxRetries.desc%"
        },
        "gitCommitGeniex.llm.temperature": {
          "order": 6,
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "markdownDescription": "%config.llm.temperature.desc%"
        },
        "gitCommitGeniex.local.baseUrl": {
          "order": 7,
          "type": "string",
          "default": "",
          "markdownDescription": "%config.local.baseUrl.desc%"
        },
        "gitCommitGeniex.repositoryAnalysis.enabled": {
          "order": 11,
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.repositoryAnalysis.enabled.desc%"
        },
        "gitCommitGeniex.repositoryAnalysis.excludePatterns": {
          "order": 13,
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.repositoryAnalysis.excludePatterns.desc%"
        },
        "gitCommitGeniex.repositoryAnalysis.updateThreshold": {
          "order": 14,
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 32,
          "markdownDescription": "%config.repositoryAnalysis.updateThreshold.desc%"
        },
        "gitCommitGeniex.ui.stageNotifications.enabled": {
          "order": 10,
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.ui.stageNotifications.enabled.desc%"
        },
        "gitCommitGeniex.rag.enabled": {
          "order": 19,
          "type": "boolean",
          "default": false,
          "tags": [
            "experimental"
          ],
          "markdownDescription": "%config.rag.enabled.desc%"
        },
        "gitCommitGeniex.rag.embedding.baseUrl": {
          "order": 20,
          "type": "string",
          "default": "",
          "tags": [
            "experimental"
          ],
          "markdownDescription": "%config.rag.embedding.baseUrl.desc%"
        },
        "gitCommitGeniex.rag.embedding.model": {
          "order": 21,
          "type": "string",
          "default": "",
          "tags": [
            "experimental"
          ],
          "markdownDescription": "%config.rag.embedding.model.desc%"
        },
        "gitCommitGeniex.rag.embedding.dimensions": {
          "order": 22,
          "type": "number",
          "default": 0,
          "minimum": 0,
          "tags": [
            "experimental"
          ],
          "markdownDescription": "%config.rag.embedding.dimensions.desc%"
        },
        "gitCommitGeniex.rag.embedding.batchSize": {
          "order": 23,
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 512,
          "tags": [
            "experimental"
          ],
          "markdownDescription": "%config.rag.embedding.batchSize.desc%"
        },
        "gitCommitGeniex.repositoryAnalysis.MaxCount": {
          "order": 15,
          "type": "number",
          "default": -1,
          "minimum": -1,
          "markdownDescription": "%config.repositoryAnalysis.MaxCount.desc%"
        },
        "gitCommitGeniex.repositoryAnalysis.toolResult.maxContentChars": {
          "order": 16,
          "type": "number",
          "default": 40000,
          "minimum": 1000,
          "markdownDescription": "%config.repositoryAnalysis.toolResult.maxContentChars.desc%"
        },
        "gitCommitGeniex.repositoryAnalysis.toolResult.maxListLines": {
          "order": 17,
          "type": "number",
          "default": 3000,
          "minimum": 10,
          "markdownDescription": "%config.repositoryAnalysis.toolResult.maxListLines.desc%"
        },
        "gitCommitGeniex.repositoryAnalysis.toolResult.maxSnippetChars": {
          "order": 18,
          "type": "number",
          "default": 8000,
          "minimum": 100,
          "markdownDescription": "%config.repositoryAnalysis.toolResult.maxSnippetChars.desc%"
        },
        "gitCommitGeniex.repositoryAnalysis.model": {
          "order": 12,
          "type": "string",
          "default": "general",
          "enum": [
            "general",
            "gpt-5.4",
            "gpt-5.4-mini",
            "gpt-5.4-nano",
            "gpt-5",
            "gpt-5.2",
            "gpt-5-mini",
            "gpt-5-nano",
            "deepseek-flash",
            "deepseek-v4-pro",
            "claude-opus-4-7",
            "claude-opus-4-6",
            "claude-sonnet-4-6",
            "claude-opus-4-1",
            "claude-haiku-4-5",
            "claude-sonnet-4-5",
            "claude-opus-4-5",
            "gemini-2.5-flash",
            "gemini-2.5-flash-preview-09-2025",
            "gemini-3-flash-preview",
            "gemini-2.5-pro",
            "gemini-3-pro-preview",
            "glm-5",
            "glm-5-turbo",
            "glm-4.7",
            "glm-4.7-flashx",
            "glm-4.7-flash",
            "glm-4.5",
            "glm-4.5-air",
            "kimi-k2.5",
            "kimi-k2",
            "kimi-k2-thinking",
            "openai/gpt-5.4",
            "openai/gpt-5.4-mini",
            "openai/gpt-5.4-nano",
            "openai/gpt-5",
            "openai/gpt-5.2",
            "openai/gpt-5-mini",
            "openai/gpt-5-nano",
            "deepseek/deepseek-v4-flash",
            "deepseek/deepseek-v4-pro",
            "anthropic/claude-opus-4.7",
            "anthropic/claude-opus-4.6",
            "anthropic/claude-sonnet-4.6",
            "anthropic/claude-opus-4.1",
            "anthropic/claude-haiku-4.5",
            "anthropic/claude-sonnet-4.5",
            "anthropic/claude-opus-4.5",
            "google/gemini-2.5-flash",
            "google/gemini-2.5-pro",
            "google/gemini-3-flash-preview",
            "google/gemini-3-pro-preview",
            "qwen/qwen3-max",
            "qwen/qwen3-235b-a22b",
            "qwen/qwen3.5-flash",
            "qwen/qwen-plus",
            "qwen/qwen3-coder-plus",
            "qwen/qwen-turbo",
            "qwen/qwen3-coder-30b-a3b-instruct",
            "z-ai/glm-5",
            "z-ai/glm-5-turbo",
            "z-ai/glm-4.7",
            "z-ai/glm-4.7-flashx",
            "z-ai/glm-4.7-flash",
            "z-ai/glm-4.5",
            "z-ai/glm-4.5-air",
            "moonshotai/kimi-k2.5",
            "moonshotai/kimi-k2",
            "moonshotai/kimi-k2-thinking"
          ],
          "enumDescriptions": [
            "%config.repositoryAnalysis.model.general%",
            "OpenAI",
            "OpenAI",
            "OpenAI",
            "OpenAI",
            "OpenAI",
            "OpenAI",
            "OpenAI",
            "DeepSeek",
            "DeepSeek",
            "Anthropic",
            "Anthropic",
            "Anthropic",
            "Anthropic",
            "Anthropic",
            "Anthropic",
            "Anthropic",
            "Gemini",
            "Gemini",
            "Gemini",
            "Gemini",
            "Gemini",
            "GLM",
            "GLM",
            "GLM",
            "GLM",
            "GLM",
            "GLM",
            "GLM",
            "Kimi",
            "Kimi",
            "Kimi",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter",
            "OpenRouter"
          ],
          "markdownDescription": "%config.repositoryAnalysis.model.desc%"
        },
        "gitCommitGeniex.commitLanguage": {
          "order": 2,
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "zh-CN",
            "zh-TW",
            "ja",
            "ko",
            "de",
            "fr",
            "es",
            "pt",
            "ru",
            "it"
          ],
          "enumDescriptions": [
            "%config.commitLanguage.auto%",
            "%config.commitLanguage.en%",
            "%config.commitLanguage.zhCN%",
            "%config.commitLanguage.zhTW%",
            "%config.commitLanguage.ja%",
            "%config.commitLanguage.ko%",
            "%config.commitLanguage.de%",
            "%config.commitLanguage.fr%",
            "%config.commitLanguage.es%",
            "%config.commitLanguage.pt%",
            "%config.commitLanguage.ru%",
            "%config.commitLanguage.it%"
          ],
          "markdownDescription": "%config.commitLanguage.desc%"
        },
        "gitCommitGeniex.typingAnimationSpeed": {
          "order": 8,
          "type": "number",
          "default": 15,
          "minimum": -1,
          "maximum": 100,
          "markdownDescription": "%config.typingAnimationSpeed.desc%"
        },
        "gitCommitGeniex.showUsageCost": {
          "order": 9,
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.showUsageCost.desc%"
        }
      }
    },
    "views": {
      "scm": [
        {
          "type": "webview",
          "id": "gitCommitGeniex.panel",
          "icon": "$(genie-base)",
          "name": "Git Commit GenieX"
        }
      ]
    },
    "commands": [
      {
        "command": "git-commit-geniex.generateCommitMessage",
        "title": "%command.generate%",
        "icon": "$(genie-base)"
      },
      {
        "command": "git-commit-geniex.cancelRepositoryAnalysis",
        "title": "%command.cancelRepositoryAnalysis%",
        "category": "%category.title%",
        "icon": "$(stop)",
        "enablement": "gitCommitGeniex.repositoryAnalysisEnabled == true && gitCommitGeniex.hasGitRepo == true && gitCommitGeniex.analysisRunning == true"
      },
      {
        "command": "git-commit-geniex.cancelGeneration",
        "title": "%command.cancel%",
        "icon": "$(debug-stop)",
        "category": "%category.title%"
      },
      {
        "command": "git-commit-geniex.manageModels",
        "title": "%command.manageModels%",
        "category": "%category.title%",
        "icon": "$(gear)"
      },
      {
        "command": "git-commit-geniex.configureRagEmbeddingApiKey",
        "title": "%command.configureRagEmbeddingApiKey%",
        "category": "%category.title%",
        "icon": "$(key)"
      },
      {
        "command": "git-commit-geniex.clearRagEmbeddingApiKey",
        "title": "%command.clearRagEmbeddingApiKey%",
        "category": "%category.title%",
        "icon": "$(trash)"
      },
      {
        "command": "git-commit-geniex.startRagIndexing",
        "title": "%command.startRagIndexing%",
        "category": "%category.title%",
        "icon": "$(play)",
        "enablement": "gitCommitGeniex.hasGitRepo == true && gitCommitGeniex.ragEnabled == true"
      },
      {
        "command": "git-commit-geniex.cancelRagIndexing",
        "title": "%command.cancelRagIndexing%",
        "category": "%category.title%",
        "icon": "$(debug-stop)",
        "enablement": "gitCommitGeniex.hasGitRepo == true && gitCommitGeniex.ragEnabled == true && gitCommitGeniex.ragIndexing == true"
      },
      {
        "command": "git-commit-geniex.toggleChainMode",
        "title": "%command.toggleChain%",
        "category": "%category.title%",
        "icon": "$(circuit-board)"
      },
      {
        "command": "git-commit-geniex.selectTemplate",
        "title": "%command.selectTemplate%",
        "category": "%category.title%",
        "icon": "$(file-text)"
      },
      {
        "command": "git-commit-geniex.viewRepositoryAnalysis",
        "title": "%command.viewRepositoryAnalysis%",
        "category": "%category.title%",
        "icon": "$(search)",
        "enablement": "gitCommitGeniex.repositoryAnalysisEnabled == true && gitCommitGeniex.hasGitRepo == true"
      },
      {
        "command": "git-commit-geniex.refreshRepositoryAnalysis",
        "title": "%command.refreshRepositoryAnalysis%",
        "category": "%category.title%",
        "icon": "$(refresh)",
        "enablement": "gitCommitGeniex.repositoryAnalysisEnabled == true && gitCommitGeniex.hasGitRepo == true && gitCommitGeniex.analysisRunning != true"
      },
      {
        "command": "git-commit-geniex.clearRepositoryAnalysisCache",
        "title": "%command.clearRepositoryAnalysisCache%",
        "category": "%category.title%",
        "icon": "$(trash)",
        "enablement": "gitCommitGeniex.hasGitRepo == true && gitCommitGeniex.analysisRunning != true"
      },
      {
        "command": "git-commit-geniex.genieMenu",
        "title": "Git Commit GenieX: Menu",
        "category": "%category.title%",
        "icon": "$(menu)"
      },
      {
        "command": "git-commit-geniex.showRepositoryCost",
        "title": "%command.showRepositoryCost%",
        "category": "%category.title%",
        "icon": "$(info)"
      },
      {
        "command": "git-commit-geniex.resetRepositoryCost",
        "title": "%command.resetRepositoryCost%",
        "category": "%category.title%",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "git-commit-geniex.generateCommitMessage",
          "when": "scmProvider == 'git' && gitCommitGeniex.generating != true",
          "group": "navigation"
        },
        {
          "command": "git-commit-geniex.cancelGeneration",
          "when": "scmProvider == 'git' && gitCommitGeniex.generating == true",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "git-commit-geniex.cancelRepositoryAnalysis",
          "when": "false"
        },
        {
          "command": "git-commit-geniex.refreshRepositoryAnalysis",
          "when": "gitCommitGeniex.repositoryAnalysisEnabled == true && gitCommitGeniex.hasGitRepo == true && gitCommitGeniex.analysisRunning != true"
        },
        {
          "command": "git-commit-geniex.clearRepositoryAnalysisCache",
          "when": "gitCommitGeniex.hasGitRepo == true && gitCommitGeniex.analysisRunning != true"
        },
        {
          "command": "git-commit-geniex.startRagIndexing",
          "when": "gitCommitGeniex.hasGitRepo == true && gitCommitGeniex.ragEnabled == true"
        },
        {
          "command": "git-commit-geniex.cancelRagIndexing",
          "when": "gitCommitGeniex.hasGitRepo == true && gitCommitGeniex.ragEnabled == true && gitCommitGeniex.ragIndexing == true"
        },
        {
          "command": "git-commit-geniex.cancelRepositoryAnalysis",
          "when": "gitCommitGeniex.repositoryAnalysisEnabled == true && gitCommitGeniex.hasGitRepo == true && gitCommitGeniex.analysisRunning == true"
        }
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "css-loader": "^7.1.2",
    "eslint": "^9.32.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sinon": "^21.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.2",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.63.0",
    "@google/genai": "^1.16.0",
    "@vscode/codicons": "^0.0.41",
    "openai": "^5.23.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.1.11"
  },
  "overrides": {
    "zod": "^4.1.11"
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/northwang-lucky/git-commit-genie.git"
  },
  "homepage": "https://github.com/northwang-lucky/git-commit-genie",
  "bugs": {
    "url": "https://github.com/northwang-lucky/git-commit-genie/issues"
  }
}
